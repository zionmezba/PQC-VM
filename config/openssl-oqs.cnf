# PQC-aware OpenSSL profile: loads oqsprovider alongside the default provider.
#
# Select it with:  OPENSSL_CONF=/work/config/openssl-oqs.cnf
# Omit it to get the *legacy* profile (default provider only, no PQC) — that
# profile is what the legacy-compatibility test in bench/attack.py exercises.
openssl_conf = openssl_init

[openssl_init]
providers = provider_sect

[provider_sect]
default = default_sect
oqsprovider = oqsprovider_sect

[default_sect]
activate = 1

[oqsprovider_sect]
# MUST be an absolute path. A bare module name ("oqsprovider") is NOT resolved
# against OPENSSL_MODULES by OpenSSL 3.0.13 -- the provider is silently not
# loaded, `openssl list -providers` shows only the default provider, and the
# exit code is still 0. There is no error to notice, so any experiment that
# thinks it is exercising the PQC-aware profile would in fact be running the
# legacy one and reporting it under the wrong name.
module = /opt/oqs-modules/oqsprovider.so
activate = 1
